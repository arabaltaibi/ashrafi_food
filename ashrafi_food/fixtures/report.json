  "module": "Accounts",
  "name": "test2",
  "parent": null,
  "parentfield": null,
  "parenttype": null,
  "prepared_report": 0,
  "query": "SELECT pe.user_name,\r\n               SUM(CASE WHEN pe.mode_of_payment = 'Cash' THEN pe.paid_amount ELSE 0 END) AS cash_amount,\r\n               SUM(CASE WHEN pe.mode_of_payment = 'Wire Transfer' THEN pe.paid_amount ELSE 0 END) AS wire_transfer_amount,\r\n               SUM(pdc.amount_paid) AS amount_paid\r\n        FROM `tabPDC` AS pdc\r\n        RIGHT JOIN `tabPayment Entry` AS pe\r\n        ON pdc.user_name=pe.user_name\r\n        GROUP BY pdc.user_name\r\n        ",
  "ref_doctype": "PDC",
