  "modified": "2023-05-09 20:53:39.606803",
  "module": "Accounts",
  "name": "Payment Entry",
  "parent": null,
  "parentfield": null,
  "parenttype": null,
  "prepared_report": 0,
  "query": "SELECT\n    pe.name AS \"ID:Link/Payment Entry:220\",\n    per.bill_no AS \"Bill No.:Data:100\",\n    pe.posting_date AS \"Posting Date:Date:100\",\n    per.total_amount AS \"Bill Amount:Float:150\",\n    pe.party_name AS \"Party:Data:100\",\n    pe.bill_type AS \"Bill:Data:150\",\n    co.territory AS \"Area:Link/Territory:220\",\n    co.primary_address AS \"Address:Data:220\",\n    per.allocated_amount AS \"Received Amount:Float:100\",\n    pe.mode_of_payment AS \"Mode Of Payment:Data:100\",\n    pe.reference_no AS \"Cheque#:Data:100\",\n    pe.reference_date AS \"Cheque Date:Date:100\",\n    per.outstanding_amount AS \"Balance Amount:Float:100\",\n    pe.status AS \"Status:Select:150\"\nFROM\n    `tabPayment Entry` AS pe\nLEFT JOIN\n    `tabPayment Entry Reference` AS per ON per.parent = pe.name\nLEFT JOIN\n    `tabCustomer` AS co ON co.name = pe.party_name\nWHERE\n    pe.docstatus = 1\n    AND pe.posting_date >= %(from_date)s\n    AND pe.posting_date <= %(to_date)s\n",
  "ref_doctype": "Payment Entry",
  "reference_report": "",
  "report_name": "Payment Entry",
  "report_script": "frappe.query_reports['Payment Entry'] = {\n    filters: [\n        {\n            fieldname: \"from_date\",\n            label: __(\"From Date\"),\n            fieldtype: \"Date\",\n            default: frappe.datetime.nowdate()\n        },\n        {\n            fieldname: \"to_date\",\n            label: __(\"To Date\"),\n            fieldtype: \"Date\",\n            default: frappe.datetime.nowdate()\n        },\n           ]\n};\n",
  "report_type": "Query Report",
  "roles": [
